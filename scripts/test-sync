#!/bin/bash

# Offline tests for scripts/sync-upstream. Each case runs against a fresh copy
# of the repo and answers every fetch from a fixture tree (--fixtures), laid
# out by URL host and path, so nothing is fetched and the real tree is never
# written. The fixtures start as a mirror of what upstream.json records; each
# case changes the part it is about. Needs bash, git, python3 and jq.

set -euo pipefail
cd "$(dirname "$0")/.."

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failures=0

release=$(jq -r '."terminal-screensaver".release' upstream.json)
ttfx_version=$(jq -r '."system-ttfx".version' upstream.json)
native_version=$(jq -r '."native-screensaver".version' upstream.json)
bundled_version=$(jq -r '."native-screensaver".ttfx.version' upstream.json)
raw=raw.githubusercontent.com

# registry EXTRA DROP: a ttfx src/effects/mod.rs with Model.js's effects,
# minus DROP, plus EXTRA (a lowercase name, documented as "Something new.").
registry() {
  python3 - "$1" "$2" <<'EOF'
import re, sys
extra, drop = sys.argv[1], sys.argv[2]
names = re.findall(r'^    \{ value: "([a-z0-9-]+)"', open("Model.js").read(), re.M)
names = [n for n in names if n != drop] + ([extra] if extra else [])
print("pub enum EffectCommand {")
for n in names:
    variant = "".join(part.capitalize() for part in n.split("-"))
    struct = "NewFx" if n == extra else variant
    doc = "Something new." if n == extra else f"The {n} effect."
    print(f"    /// {doc}\n    {variant}({n.replace('-', '_')}::{struct}Config),")
print("}")
EOF
}

# put CASE PATH: stdin becomes the fixture for https://PATH in that case.
put() {
  mkdir -p "$(dirname "$tmp/$1/fixtures/$2")"
  cat >"$tmp/$1/fixtures/$2"
}

# releases TAG...: a GitHub release list; TAG:pre marks a prerelease.
releases() {
  local list="" tag
  for tag in "$@"; do
    list+="{\"tag_name\":\"${tag%:pre}\",\"draft\":false,\"prerelease\":$([[ $tag == *:pre ]] && echo true || echo false)},"
  done
  echo "[${list%,}]"
}

launcher_text() { printf '#!/bin/bash\n# stock launcher %s\nexec /usr/lib/omarchy-screensaver/omarchy-screensaver "$@"\n' "$1"; }

# fresh CASE: a copy of the repo at $tmp/CASE whose fixtures mirror what
# upstream.json records, with a stand-in launcher whose blob upstream.json
# records as reviewed.
fresh() {
  local name=$1 dir=$tmp/$1
  mkdir -p "$dir/scripts" "$dir/extras"
  cp Model.js README.md manifest.json CHANGELOG.md "$dir/"
  cp -r i18n "$dir/"
  # A translated catalog, to see a dropped effect leave every language.
  printf '{\n  "effect.wipe.name": "Balayage",\n  "title": "Économiseur"\n}\n' >"$dir/i18n/fr.json"
  cp scripts/sync-upstream "$dir/scripts/"
  cp extras/omarchy-launch-screensaver extras/omarchy-screensaver extras/omarchy-screensaver.stock "$dir/extras/"
  launcher_text "$release" >"$tmp/launcher"
  jq --arg blob "$(git hash-object "$tmp/launcher")" '.launcher.blob = $blob' upstream.json >"$dir/upstream.json"

  releases "$release" "v0.0.1" | put "$name" api.github.com/repos/basecamp/omarchy/releases
  put "$name" "$raw/basecamp/omarchy/$release/bin/omarchy-screensaver" <extras/omarchy-screensaver.stock
  put "$name" "$raw/basecamp/omarchy/$release/bin/omarchy-launch-screensaver" <"$tmp/launcher"
  printf 'pkgname=ttfx\npkgver=%s\nurl="https://github.com/omacom/ttfx"\n' "$ttfx_version" |
    put "$name" "$raw/omacom-io/omarchy-pkgs/HEAD/pkgbuilds/ttfx/PKGBUILD"
  printf 'pkgname=omarchy-screensaver\npkgver=%s\nurl="https://github.com/omacom/omarchy-screensaver"\n' "$native_version" |
    put "$name" "$raw/omacom-io/omarchy-pkgs/HEAD/pkgbuilds/omarchy-screensaver/PKGBUILD"
  printf '[dependencies]\nttfx = { git = "https://github.com/omacom/ttfx", tag = "v%s" }\n' "$bundled_version" |
    put "$name" "$raw/omacom/omarchy-screensaver/v$native_version/Cargo.toml"
  registry "" "" | put "$name" "$raw/omacom/ttfx/v$ttfx_version/src/effects/mod.rs"
  registry "" "" | put "$name" "$raw/omacom/ttfx/v$bundled_version/src/effects/mod.rs"
}

# sync CASE [sync-upstream args...]: run it in that case's copy.
sync() {
  local name=$1
  shift
  (cd "$tmp/$name" && python3 scripts/sync-upstream --out-dir out --fixtures fixtures "$@") \
    >"$tmp/$name.out" 2>&1 || echo "exit $?" >>"$tmp/$name.out"
}

output() { sed -n "s/^$2=//p" "$tmp/$1.out"; }
flags() { echo "$(output "$1" changed) $(output "$1" release) $(output "$1" attention)"; }
lock() { jq -r "$2" "$tmp/$1/upstream.json"; }
clean() { grep -c -e Traceback -e '^exit ' "$tmp/$1.out" || true; }

expect() {
  local name=$1 want=$2 got=$3
  if [[ $got == "$want" ]]; then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "  want: $want"
    echo "  got:  $got"
    failures=$((failures + 1))
  fi
}

# --- nothing moved
fresh same
sync same
expect "upstream as recorded: nothing to do" "false false false" "$(flags same)"

fresh prerelease
releases "v9.0.0-rc1:pre" "v9.0.0:pre" "$release" | put prerelease api.github.com/repos/basecamp/omarchy/releases
sync prerelease
expect "a newer prerelease is not a release users run" "false false false" "$(flags prerelease)"

# --- effects
fresh moved
registry "newfx" "wipe" | put moved "$raw/omacom/ttfx/v$ttfx_version/src/effects/mod.rs"
registry "newfx" "wipe" | put moved "$raw/omacom/ttfx/v$bundled_version/src/effects/mod.rs"
sync moved
expect "an effect added and one dropped by every ttfx: changed, released" "true true false" "$(flags moved)"
expect "the new effect lands in Model.js" \
  '    { value: "newfx", label: tr.t("effect.newfx.name"), description: tr.t("effect.newfx.description") },' \
  "$(grep '"newfx"' "$tmp/moved/Model.js")"
expect "with the registry's label and description in en.json" "New Fx|Something new" \
  "$(jq -r '[."effect.newfx.name", ."effect.newfx.description"] | join("|")' "$tmp/moved/i18n/en.json")"
expect "the dropped effect is gone from Model.js" "0" "$(grep -c '"wipe"' "$tmp/moved/Model.js" || true)"
expect "and from every catalog" "0 0" \
  "$(grep -c 'effect.wipe' "$tmp/moved/i18n/en.json" || true) $(grep -c 'effect.wipe' "$tmp/moved/i18n/fr.json" || true)"
expect "the rest of a translated catalog stays" "Économiseur" "$(jq -r .title "$tmp/moved/i18n/fr.json")"
expect "minor version bump in manifest.json" \
  "$(jq -r .version manifest.json | awk -F. '{print $1"."$2+1".0"}')" "$(jq -r .version "$tmp/moved/manifest.json")"
expect "the result passes --lint" "0" "$(cd "$tmp/moved" && python3 scripts/sync-upstream --lint >/dev/null 2>&1; echo $?)"
expect "the release notes name the new effect" "1" "$(grep -c 'newfx' "$tmp/moved/out/notes.md")"

# The two ttfx builds disagree: the list keeps to what both have.
fresh native-only
next=$(awk -F. '{print $1"."$2"."$3+1}' <<<"$bundled_version")
printf '[dependencies]\nttfx = { git = "https://github.com/omacom/ttfx", tag = "v%s" }\n' "$next" |
  put native-only "$raw/omacom/omarchy-screensaver/v$native_version/Cargo.toml"
registry "newfx" "" | put native-only "$raw/omacom/ttfx/v$next/src/effects/mod.rs"
sync native-only
expect "an effect only the native screensaver's ttfx has waits: recorded, not released" \
  "true false false" "$(flags native-only)"
expect "upstream.json records the bundled ttfx" "$next" "$(lock native-only '."native-screensaver".ttfx.version')"
expect "Model.js doesn't list it" "0" "$(grep -c '"newfx"' "$tmp/native-only/Model.js" || true)"

fresh system-drop
next=$(awk -F. '{print $1"."$2"."$3+1}' <<<"$ttfx_version")
printf 'pkgname=ttfx\npkgver=%s\nurl="https://github.com/omacom/ttfx"\n' "$next" |
  put system-drop "$raw/omacom-io/omarchy-pkgs/HEAD/pkgbuilds/ttfx/PKGBUILD"
registry "" "wipe" | put system-drop "$raw/omacom/ttfx/v$next/src/effects/mod.rs"
sync system-drop
expect "an effect the ttfx package drops leaves the list, though the native one has it" "true true" \
  "$(output system-drop changed) $(output system-drop release)"
expect "and the changelog says which ttfx dropped it" "1" \
  "$(grep -cF "wipe\` effect, which ttfx $next (the ttfx package) no longer has." "$tmp/system-drop/CHANGELOG.md")"

fresh bumped
printf 'pkgname=omarchy-screensaver\npkgver=9.9.9\nurl="https://github.com/omacom/omarchy-screensaver"\n' |
  put bumped "$raw/omacom-io/omarchy-pkgs/HEAD/pkgbuilds/omarchy-screensaver/PKGBUILD"
printf '[dependencies]\nttfx = { git = "https://github.com/omacom/ttfx", tag = "v%s" }\n' "$bundled_version" |
  put bumped "$raw/omacom/omarchy-screensaver/v9.9.9/Cargo.toml"
sync bumped
expect "a new package version alone: recorded, not released" "true false false" "$(flags bumped)"
expect "upstream.json records it" "9.9.9" "$(lock bumped '."native-screensaver".version')"
expect "the effect list is untouched" "" \
  "$(diff Model.js "$tmp/bumped/Model.js"; diff i18n/en.json "$tmp/bumped/i18n/en.json")"

fresh unreadable
echo "no enum here" | put unreadable "$raw/omacom/ttfx/v$ttfx_version/src/effects/mod.rs"
sync unreadable
expect "an unreadable registry is reported, not raised" "false false true 0" "$(flags unreadable) $(clean unreadable)"
expect "with a title for the issue" \
  "Upstream sync can't read the ttfx effect list" "$(output unreadable attention_title)"

fresh no-pkgbuild
rm "$tmp/no-pkgbuild/fixtures/$raw/omacom-io/omarchy-pkgs/HEAD/pkgbuilds/ttfx/PKGBUILD"
sync no-pkgbuild
expect "a ttfx PKGBUILD that moved is reported, and nothing is recorded" "false false true 0" \
  "$(flags no-pkgbuild) $(clean no-pkgbuild)"

# --- a new Omarchy release
fresh release-same
releases "v9.0.0" "$release" | put release-same api.github.com/repos/basecamp/omarchy/releases
put release-same "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-screensaver" <extras/omarchy-screensaver.stock
launcher_text "$release" | put release-same "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-launch-screensaver"
sync release-same
expect "a release that leaves both scripts alone: recorded, not released" "true false false" "$(flags release-same)"
expect "upstream.json moves both to it" "v9.0.0 v9.0.0" \
  "$(lock release-same '."terminal-screensaver".release + " " + .launcher.release')"
expect "the override is untouched" "" "$(diff extras/omarchy-screensaver "$tmp/release-same/extras/omarchy-screensaver")"

fresh resync
releases "v9.0.0" "$release" | put resync api.github.com/repos/basecamp/omarchy/releases
sed 's|# Set background color to black$|# Set background color to black, the screensaver terminal|' extras/omarchy-screensaver.stock |
  put resync "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-screensaver"
launcher_text "$release" | put resync "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-launch-screensaver"
sync resync
expect "a stock change that merges cleanly: changed, released" "true true false" "$(flags resync)"
expect "the override gains the stock change" "1" \
  "$(grep -c 'black, the screensaver terminal$' "$tmp/resync/extras/omarchy-screensaver")"
expect "and keeps its pinning" "1" "$(grep -c 'include-effects' "$tmp/resync/extras/omarchy-screensaver")"
expect "the merge base is the new stock script" "" \
  "$(diff "$tmp/resync/fixtures/$raw/basecamp/omarchy/v9.0.0/bin/omarchy-screensaver" "$tmp/resync/extras/omarchy-screensaver.stock")"
expect "patch version bump in manifest.json" \
  "$(jq -r .version manifest.json | awk -F. '{print $1"."$2"."$3+1}')" "$(jq -r .version "$tmp/resync/manifest.json")"
expect "the release notes say to reinstall the override" "1" \
  "$(grep -c 'sudo install -m 755 .*extras/omarchy-screensaver /usr/local/bin/omarchy-screensaver' "$tmp/resync/out/notes.md")"
expect "upstream.json records the release" "v9.0.0" "$(lock resync '."terminal-screensaver".release')"

fresh conflict
releases "v9.0.0" "$release" | put conflict api.github.com/repos/basecamp/omarchy/releases
sed 's|--random-effect --no-eol|--random-effect --no-wrap --no-eol|' extras/omarchy-screensaver.stock |
  put conflict "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-screensaver"
launcher_text "$release" | put conflict "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-launch-screensaver"
sync conflict
expect "a stock change that conflicts: attention, no release" "false true" \
  "$(output conflict release) $(output conflict attention)"
expect "with a title for the issue" \
  "Omarchy v9.0.0's omarchy-screensaver no longer merges onto the override" "$(output conflict attention_title)"
expect "and the override as it was, merged with the release it was" "$release" \
  "$(diff extras/omarchy-screensaver "$tmp/conflict/extras/omarchy-screensaver"; lock conflict '."terminal-screensaver".release')"
sync conflict --write-conflicts
expect "--write-conflicts writes the merge with its markers" "1" \
  "$(grep -c '^<<<<<<< extras/omarchy-screensaver$' "$tmp/conflict/extras/omarchy-screensaver")"

fresh drift
releases "v9.0.0" "$release" | put drift api.github.com/repos/basecamp/omarchy/releases
put drift "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-screensaver" <extras/omarchy-screensaver.stock
launcher_text "v9.0.0" | put drift "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-launch-screensaver"
sync drift
expect "a launcher change: attention" "true" "$(output drift attention)"
expect "with a title for the issue" \
  "Omarchy v9.0.0 changed omarchy-launch-screensaver: check the effect-pinning wrapper" "$(output drift attention_title)"
expect "and the reviewed launcher stays in upstream.json" "$release" "$(lock drift .launcher.release)"
(cd "$tmp/drift" && python3 scripts/sync-upstream --fixtures fixtures --accept-launcher) >/dev/null
expect "--accept-launcher records the release's launcher" "v9.0.0 $(launcher_text v9.0.0 | git hash-object --stdin)" \
  "$(lock drift '.launcher.release + " " + .launcher.blob')"
sync drift
expect "after which the sync is quiet" "false" "$(output drift attention)"

# The switch to the native screensaver: no bin/omarchy-screensaver, and a
# launcher that hands off to the native binary.
fresh native
releases "v9.0.0" "$release" | put native api.github.com/repos/basecamp/omarchy/releases
launcher_text "v9.0.0" | put native "$raw/basecamp/omarchy/v9.0.0/bin/omarchy-launch-screensaver"
sync native
expect "a release without the terminal screensaver is reported, not raised" "false false true 0" \
  "$(flags native) $(clean native)"
expect "together with the launcher change, in one issue" "Upstream sync needs attention 2" \
  "$(output native attention_title) $(grep -c '^## ' "$tmp/native/out/attention.md")"
expect "which names the switch" "1" \
  "$(grep -c '^## Omarchy v9.0.0 no longer ships omarchy-screensaver: stop syncing the override$' "$tmp/native/out/attention.md")"
expect "the override stays as it was" "" "$(diff extras/omarchy-screensaver "$tmp/native/extras/omarchy-screensaver")"
(cd "$tmp/native" && python3 scripts/sync-upstream --fixtures fixtures --accept-removal) >/dev/null
expect "--accept-removal records it" "v9.0.0" "$(lock native '."terminal-screensaver".removed_in')"
sync native
expect "after which only the launcher is reported" \
  "Omarchy v9.0.0 changed omarchy-launch-screensaver: check the effect-pinning wrapper" "$(output native attention_title)"
expect "and --lint still passes" "0" "$(cd "$tmp/native" && python3 scripts/sync-upstream --lint >/dev/null 2>&1; echo $?)"

fresh no-releases
rm "$tmp/no-releases/fixtures/api.github.com/repos/basecamp/omarchy/releases"
registry "newfx" "" | put no-releases "$raw/omacom/ttfx/v$ttfx_version/src/effects/mod.rs"
registry "newfx" "" | put no-releases "$raw/omacom/ttfx/v$bundled_version/src/effects/mod.rs"
sync no-releases
expect "no readable release list: reported, and the effects still sync" "true true true 0" \
  "$(flags no-releases) $(clean no-releases)"

fresh both
echo "no enum here" | put both "$raw/omacom/ttfx/v$ttfx_version/src/effects/mod.rs"
launcher_text "v-changed" | put both "$raw/basecamp/omarchy/$release/bin/omarchy-launch-screensaver"
sync both
expect "two problems at once: one issue covering both" "Upstream sync needs attention 2" \
  "$(output both attention_title) $(grep -c '^## ' "$tmp/both/out/attention.md")"

if ((failures)); then
  echo "$failures failure(s)" >&2
  exit 1
fi
echo "All sync tests passed."
